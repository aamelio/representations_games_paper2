        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function()\n{\n\n\nvar score = 0;\nvar round = parseInt(\"${e://Field/round}\");\nQualtrics.SurveyEngine.setEmbeddedData('round', round + 1);\n\t\nfunction updateScore(i) {\n\t\n   document.getElementById(\"slider\" + i).className = \"slider_click\"\n   var val = document.getElementById(\"slider\" + i).value //get the oninput value\n   document.getElementById('value' + i).innerHTML = val //display this value to the html page\n  if(val == 50){score ++;}\n  document.getElementById(\"pointScore\").innerHTML = score;\n}\n\n\t\n document.getElementById(\"slider1\").oninput = function() {\n\twriteValue1();\n    getValue1();\n\t updateScore(\"1\");\n };\n\nfunction writeValue1() {\n   document.getElementById(\"slider1\").className = \"slider_click\"\n   var val = document.getElementById(\"slider1\").value //get the oninput value\n   document.getElementById('value1').innerHTML = val //display this value to the html page\n}\n\n\tfunction getValue1() {\n\t\tvar val = document.getElementById(\"slider1\").value //get the oninput value\n\t\tQualtrics.SurveyEngine.setEmbeddedData('slider_1', val)\n\t}\n\ndocument.getElementById(\"slider2\").oninput = function() {\n\twriteValue2();\n    getValue2();\n\tupdateScore(\"2\");\n};\n\nfunction writeValue2() {\n   document.getElementById(\"slider2\").className = \"slider_click\";\n   var val = document.getElementById(\"slider2\").value; // get the oninput value\n   document.getElementById('value2').innerHTML = val; // display this value to the HTML page\n}\n\nfunction getValue2() {\n\tvar val = document.getElementById(\"slider2\").value; // get the oninput value\n\tQualtrics.SurveyEngine.setEmbeddedData('slider_2', val);\n}\n\n\tdocument.getElementById(\"slider3\").oninput = function() {\n\twriteValue3();\n    getValue3();\n\t\tupdateScore(\"3\");\n};\n\nfunction writeValue3() {\n   document.getElementById(\"slider3\").className = \"slider_click\";\n   var val = document.getElementB