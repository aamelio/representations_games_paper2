    {
      "SurveyID": "SV_6tXSKWeZcPr9FH0",
      "Element": "SQ",
      "PrimaryAttribute": "QID2",
      "SecondaryAttribute": "Instructions In both parts, you are matched with another Prolific participant. You will never kno.",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<b>Instructions</b><br />\n<br />\nIn both parts,&nbsp;you are matched with another Prolific participant.&nbsp;You will never know the identity of the person with whom you are paired, and this person will never know your identity. You and your match are provisionally allocated&nbsp;a certain amount of dollars, adding to a total of <b>$12</b>. You will have the chance to decide<b>&nbsp;whether and how to change this original allocation</b>.<br />\n<br />\n<b>After you complete the two parts of the study, one</b>&nbsp;<b>of them is selected at random</b>. The allocation chosen in the selected part will be implemented for <b>1 participant out of 10</b>. <b>This means that</b> <b>your decisions in each part affect a</b>&nbsp;<b>bonus payment</b> <b>you and the other participant may receive</b>.<br />\n<br />\nWe will also ask you some open-ended questions. Your answers to these questions are completely anonymous and do not affect your earnings, but <span style=\"color:#e74c3c;\">it is <b>crucial for our study</b> that you answer each question <b>truthfully </b>and <b>carefully</b>.</span><br />\n<br />\n&nbsp;",
        "DefaultChoices": false,
        "DataExportTag": "Q2",
        "QuestionID": "QID2",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Instructions In both parts, you are matched with another Prolific participant. You will never kno...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 9,
        "NextAnswerId": 1,
        "DisplayLogic": {
          "0": {
            "0": {
              "ChoiceLocator": "q://QID25/SelectableChoice/1",
              "Description": "<span class=\"ConjDesc\">If</span> <span class=\"QuestionDesc\">This question concerns the following problem: Often, participants click through surveys like this one without reading the instructions carefully. As a consequence, many of the participants can't be...</span> <span class=\"LeftOpDesc\">Very interested</span> <span class=\"OpDesc\">Is Selected</span> ",
              "LeftOperand": "q://QID25/SelectableChoice/1",
              "LogicType": "Question",
              "Operator": "Selected",
              "QuestionID": "QID25",
              "QuestionIDFromLocator": "QID25",
