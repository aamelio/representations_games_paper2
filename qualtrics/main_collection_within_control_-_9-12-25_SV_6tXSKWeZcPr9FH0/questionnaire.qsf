      "PrimaryAttribute": "QID67",
      "SecondaryAttribute": "You were provisionally allocated $8. The other participant was provisionally allocated $4.   You...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$8</b>. The other participant was provisionally allocated <b>$4</b>.</span><br />\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You can transfer any amount between -$4 and $8. If you choose a negative dollar transfer to the other participant, this means that you take that amount&nbsp;<i>from the other participant</i>.<br />\n<br />\nWe now present four hypothetical final allocations and we ask you to describe a real-world situation that you find similar to each.&nbsp;The situation can involve two people or groups. It can be an experience you or somebody you know lived, or it could be fictional.<br />\n<br />\nThen, you may choose the amount of your transfer.</span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "You were provisionally allocated $8. The other participant was provisionally allocated $4.   You...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionText_Unsafe": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$8</b>. The other participant was provisionally allocated <b>$4</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You can transfer any amount between -$4 and $8.  If you choose a negative dollar transfer to the other participant, this means that you take that amount&nbsp;<i>from the other participant</i>.<br><br>Afterward, we present two allocations and we ask you to describe a real-world situation that you find similar to each.<br></span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DataExportTag": "Q67",
        "QuestionID": "QID67"
      }
    },
    {
      "SurveyID": "SV_6tXSKWeZcPr9FH0",
      "Element": "SQ",
      "PrimaryAttribute": "QID68",
      "SecondaryAttribute": "Please choose your transfer to the other participant.     Your transfer: Click on the slider",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\">Please choose your transfer to the other participant.</div>\n&nbsp;\n\n<div>&nbsp;</div>\n\n<table style=\"margin-left: auto; \n  margin-right: auto;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<table id=\"${e://Field/color_1}\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td><input value=\"0\" type=\"range\" step=\"0.5\" min=\"-4\" max=\"8\" list=\"tickmarks\" id=\"bottomleftSlider\" class=\"slider\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t<center><b>Your transfer: <b><span id=\"output3\"> Click on the slider </span></b></b></center>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<b> </b></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td><br></td></tr></tbody></table></td><td></td></tr></tbody></table>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Please choose your transfer to the other participant.     Your transfer: Click on the slider",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 2,
        "NextAnswerId": 1,
        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function() {\n\n/* Bottom Left Slider */\n\n document.getElementById(\"bottomleftSlider\").oninput = function() {\n\t writeValuebottomleft();\n    getValuebottomleft();\n\tjQuery(\"#NextButton\").show();\n };\n\nfunction writeValuebottomleft() {\n   document.getElementById(\"bottomleftSlider\").className = \"slider_click\"\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   document.getElementById('output3').innerHTML =\"$\"+ val //display this value to the html page\n}\n\n\nfunction getValuebottomleft() {\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   Qualtrics.SurveyEngine.setEmbeddedData('allocation_lt', 8-val)\n}\n\n\t\n});",
        "QuestionText_Unsafe": "<div style=\"text-align: center;\">Please choose your transfer to the other participant.</div>\n&nbsp;\n\n<div>&nbsp;</div>\n\n<table style=\"margin-left: auto; \n  margin-right: auto;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<table id=\"${e://Field/color_1}\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td><input value=\"0\" type=\"range\" step=\"0.5\" min=\"-4\" max=\"8\" list=\"tickmarks\" id=\"bottomleftSlider\" class=\"slider\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t<center><b>Your transfer: <b><span id=\"output3\"> Click on the slider </span></b></b></center>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<b> </b></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td><br></td></tr></tbody></table></td><td></td></tr></tbody></table>",
        "DataExportTag": "Q68",
        "QuestionID": "QID68"
      }
