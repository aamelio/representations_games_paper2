      "PrimaryAttribute": "QID109",
      "SecondaryAttribute": "You were provisionally allocated $12. The other participant was provisionally allocated $0.   You..",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$12</b>. The other participant was provisionally allocated <b>$0</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You have the option to make a transfer to the other participant. You can transfer any amount between $0 and $12.<br><br>We now present four hypothetical final allocations and we ask you to describe a real-world situation that you find similar to each. The situation can involve two people or groups. It can be an experience you or somebody you know lived, or it could be fictional.</span></div><div style=\"text-align: left;\"><span style=\"font-size:22px;\"><br>Then, you may choose the amount of your transfer.<br></span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "You were provisionally allocated $12. The other participant was provisionally allocated $0.   You...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionText_Unsafe": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$8</b>. The other participant was provisionally allocated <b>$4</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You have the option to make a transfer to the other participant. You can transfer any amount between $0 and $8.<br><br>We now present two allocations and we ask you to describe a real-world situation that you find similar to each.<br><br>Then, you may choose the amount of your transfer.<br></span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DataExportTag": "Q109",
        "QuestionID": "QID109"
      }
