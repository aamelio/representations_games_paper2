        "SurveyMetaDescription": "The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.",
        "SurveyName": "main_collection_control_tg - 20-04-26",
        "CustomStyles": {
          "customCSS": ".slider-container {\n        display: grid;\n        grid-template-columns: 1fr 1fr 1fr;\n        gap: 20px;\n    }\n.slider-container div {\n    display: flex; /* Use flexbox for alignment */\n    align-items: center; /* Align items vertically in the center */\n    gap: 10px; /* Space between the slider and the value */\n    margin-bottom: 100px;\n}\n\n.slider-container .slider {\n    margin: 0; /* Remove margin to prevent extra space */\n}\n\n.slider-container .slider-value {\n    font-size: large; /* Adjust font size if needed */\n    min-width: 3em; /* Ensure a minimum width for the value display */\n    text-align: center; /* Center the text within the value display */\n}\n    .slider-container div:nth-child(1),\n    .slider-container div:nth-child(2),\n    .slider-container div:nth-child(3) {\n        margin-left: 0px;\n    }\n    .slider-container div:nth-child(4),\n    .slider-container div:nth-child(5),\n    .slider-container div:nth-child(6) {\n        margin-left: 30px;\n    }\n    .slider-container div:nth-child(7),\n    .slider-container div:nth-child(8),\n    .slider-container div:nth-child(9) {\n        margin-left: -10px;\n    }\n\n/* Sliders settings */\n.slider {\n    -webkit-appearance: none;\n    appearance: none;\n    width: 25em;\n    height: 2em;\n    background: #D3D3D3;\n    outline: none;\n    opacity: 0.7;\n    -webkit-transition: .2s;\n    transition: opacity .2s;\n    margin: 00px 40px 00px 40px;\n  }\n  \n  .sliderticks {\n     display: flex;\n    width: 22em;\n    justify-content: space-between;\n    margin: 00px 40px 00px 40px;\n  }\n  \n  .sliderticks p {\n    position: relative;\n    display: flex;\n    justify-content: center;\n    text-align: center;\n    width: 1px;\n    background: #D3D3D3;\n    height: 10px;\n    line-height: 40px;\n    margin: 0 0 20px 0;\n  }\n  \n  .slider:hover {\n    opacity: 1;\n  }\n\n\n:root {\n  --thumb-width: 5.4%;\n}\n\n\n  .slider::-webkit-slider-thumb {\n    -webkit-appearance: none;\n    appearance: none;\n    width: var(--thumb-width);\n    height: 2em;\n    background: #000000;\n    cursor: pointer;\n    visibility: hidden;\n  }\n  \n  .slider::-moz-range-thumb {\n    width: var(--thumb-width);\n    height: 2em;\n    background: #000000;\n    cursor: pointer;\n  }\n  \n  .slider::-ms-thumb {\n    width: var(--thumb-width);\n    height: 2em;\n    background: #000000;\n    cursor: pointer;\n  }\n\n.slider_click {\n    -webkit-appearance: none;\n    appearance: none;\n    width: 25em;\n    height: 2em;\n    background: #D3D3D3;\n    outline: none;\n    opacity: 0.7;\n    -webkit-transition: .2s;\n    transition: opacity .2s;\n    margin: 00px 40px 00px 40px;\n  }\n  \n  .slider_click:hover {\n    opacity: 1;\n  }\n\n  .slider_click::-webkit-slider-thumb {\n    -webkit-appearance: none;\n    appearance: none;\n    width: var(--thumb-width);\n    height: 2em;\n    background: #000000;\n    cursor: pointer;\n  }\n  \n  .slider_click::-moz-range-thumb {\n    width: var(--thumb-width);\n    height: 2em;\n    background: #000000;\n    cursor: pointer;\n  }\n  \n  .slider_click::-ms-thumb {\n    width: var(--thumb-width);\n    height: 2em;\n    background: #000000;\n    cursor: pointer;\n  }\n\n#menu{\npadding:10px;\nbackground-color:blue;\ncolor:white;\nfont-family:Cambria, Cochin, Georgia, Times, \"Times New Roman\", serif;\nfont-size:x-large;\nwidth:200px;\ncursor:pointer;\nmargin-bottom:2px;\nborder:1px blue solid;\n}\n\n.nascondi, .mostra{\npadding:10px;\ncolor:black;\nfont-family:Cambria, Cochin, Georgia, Times, \"Times New Roman\", serif;\nfont-size:large;\ndisplay:none;\nwidth:200px;\nborder:1px black solid;\n}\n\n.mostra{ \ndisplay:block;\n}\n\ntable { border-collapse: collapse; }\ntr { border: none; }\ntd {}\n\n/*Tooltip*/\n.tooltip {\n  position: relative;\n}\n\n.tooltip .tooltiptext {\n  visibility: hidden;\n  width:25em;\n  background-color: grey;\n  color: #fff;\n  text-align: left;\n  border-radius: 6px;\n  padding: 5px 0;\n  \n  /* Position the tooltip */\n position: absolute;\n  z-index: 5;\n  bottom: 100%;\n  left: 50%;\n  margin-left: -12.5em;\n}\n\n.tooltip:hover .tooltiptext {\n  visibility: visible;\n}\n\n\n/* Tables for different cases */\n\n#t01 {\n background-color: \t#F5F5F5;\n border-spacing: 0;\n border-collapse: separate;\n border-radius: 10px;\n border: 1px solid black;\n}\n\n#t01b {\n background-color: \t#ebf5fc;\n border-spacing: 0;\n border-collapse: separate;\n border-radius: 10px;\n border: 1px solid black;\n}\n\n#t01o {\n background-color: \t#fdf2df;\n border-spacing: 0;\n border-collapse: separate;\n border-radius: 10px;\n border: 1px solid black;\n}\n\n\nbody {\n-webkit-touch-callout: none;\n-webkit-user-select: none;\n-khtml-user-select: none;\n-moz-user-select: none;\n-ms-user-select: none;\nuser-select: none;\n}"
        }
