    {
      "SurveyID": "SV_bBeKZ8gvO8uMoo6",
      "Element": "SQ",
      "PrimaryAttribute": "QID17",
      "SecondaryAttribute": "Please choose the amout to send to Player 2.   Click on the slider    ",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\">Please choose the amout to send to Player 2.</div>\n\n<div>&nbsp;</div>\n\n<table style=\"margin-left: auto; \n  margin-right: auto;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<table id=\"${e://Field/color_1}\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td><input value=\"0\" type=\"range\" step=\"0.5\" min=\"0\" max=\"6\" list=\"tickmarks\" id=\"bottomleftSlider\" class=\"slider\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t<center><b><b><span id=\"output3\">Click on the slider </span></b></b></center>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<b> </b></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td>&nbsp;</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\t\t\t</td>\n\t\t\t<td>&nbsp;</td>\n\t\t</tr>\n\t</tbody>\n</table>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Please choose the amout to send to Player 2.   Click on the slider    ",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 2,
        "NextAnswerId": 1,
        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function() {\n\nvar endowment = 12\n\nQualtrics.SurveyEngine.setEmbeddedData('endowment', endowment)\n\n/* Bottom Left Slider */\n\n document.getElementById(\"bottomleftSlider\").oninput = function() {\n\t writeValuebottomleft();\n    getValuebottomleft();\n\tjQuery(\"#NextButton\").show();\n };\n\nfunction writeValuebottomleft() {\n   document.getElementById(\"bottomleftSlider\").className = \"slider_click\"\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   document.getElementById('output3').innerHTML =\"$\"+ val //display this value to the html page\n}\n\n\nfunction getValuebottomleft() {\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   Qualtrics.SurveyEngine.setEmbeddedData('allocation', 6-val)\n   Qualtrics.SurveyEngine.setEmbeddedData('transfer', val)\t\n}\n\n\t\n});",
        "QuestionText_Unsafe": "Please decide how to split the money between you and your match.<br><br>\n\n<div><br></div><table style=\"margin-left: auto; \n  margin-right: auto;\"><tbody><tr><td><table id=\"${e://Field/color_1}\"><tbody>\n     <tr>\n      <td><input value=\"${lm://Field/1}\" type=\"range\" step=\"1\" min=\"0\" max=\"10\" list=\"tickmarks\" id=\"topleftSlider\" class=\"slider\">\n      <div>\n      <center><b>You: <b><span id=\"output1\"> ${lm://Field/1}$</span></b></b></center>\n      </div>\n      </td>\n     </tr>\n     <tr>\n      <td><br>\n      &nbsp;</td>\n     </tr>\n     <tr>\n     </tr>\n     <tr>\n      <td><input value=\"${lm://Field/2}\" type=\"range\" step=\"1\" min=\"0\" max=\"10\" list=\"tickmarks\" id=\"bottomleftSlider\" class=\"slider\">\n      <div>\n      <center><b>Your match: <b><span id=\"output3\"> ${lm://Field/2}$</span></b></b></center>\n      </div>\n      <b> </b></td>\n     </tr>\n     <tr>\n      <td><br>\n      &nbsp;</td>\n     </tr>\n     <tr>\n     </tr>\n    </tbody>\n   </table>\n </td><td>\n    </td></tr></tbody>\n   </table>\n\n<center>&nbsp;</center>",
        "DataExportTag": "Q17",
        "QuestionID": "QID17"
      }
    },
    {
      "SurveyID": "SV_bBeKZ8gvO8uMoo6",
      "Element": "SQ",
      "PrimaryAttribute": "QID170",
      "SecondaryAttribute": "You were provisionally allocated $8. The other participant was provisionally allocated $4. We now...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$8</b>. The other participant was provisionally allocated <b>$4</b>.</span><br><br></div><div style=\"text-align: left;\"><span style=\"font-size:22px;\">We now present four hypothetical final allocations of the task you carried out. We ask you to describe a real-world situation you find each similar to.&nbsp;The situation can involve two people or groups. It can be an experience you or somebody you know lived, or it could be fictional. <br>Your answer to this question is completely anonymous and does not affect your earnings, but <span style=\"color:#e74c3c;\">it is <b>crucial for our study</b> that you answer the question <b>truthfully </b>and <b>carefully</b></span>.<br><br>Remember that the task was:<br></span></div><div style=\"text-align: left;\"><span style=\"font-size:22px;\"><br></span></div><div style=\"text-align: left;\"><span style=\"font-size:22px;\">You can transfer any amount between -$4 and $8.  If you choose a negative dollar transfer to the other participant, this means that you take that amount&nbsp;<i>from the other participant</i>.<br><br>The hypothetical allocations are:</span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DefaultChoices": false,
        "DataExportTag": "Q170",
        "QuestionID": "QID170",
        "QuestionType": "DB",
