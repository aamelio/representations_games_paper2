    {
      "SurveyID": "SV_bBeKZ8gvO8uMoo6",
      "Element": "SQ",
      "PrimaryAttribute": "QID1",
      "SecondaryAttribute": "WELCOME!   Thank you for participating in this study. You will receive $1 for completing it, plus.",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<strong>WELCOME!&nbsp;&nbsp;</strong><br>\n<br>\nThank you for participating in this study.<br>\n<br>\nYou will receive $1 for completing it, plus a potential <b>bonus payment</b> based on your choices.<br>\n<br>\nPlease make sure to read the instructions carefully. You’ll be asked a few short <b>comprehension questions</b> to confirm your understanding.<br>\n<br>\nYou’ll have two chances to answer each question. If you answer incorrectly both times, you will be automatically returned to Prolific and <b>will not be eligible for any payment</b>.",
        "DefaultChoices": false,
        "DataExportTag": "Q1",
        "QuestionID": "QID1",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "WELCOME!   Thank you for participating in this study. You will receive $1 for completing it, plus...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "DisplayLogic": {
          "0": {
            "0": {
              "Description": "<span class=\"ConjDesc\">If</span>  <span class=\"LeftOpDesc\">mistake</span> <span class=\"OpDesc\">Is Equal to</span> <span class=\"RightOpDesc\"> 0 </span>",
              "LeftOperand": "mistake",
              "LogicType": "EmbeddedField",
              "Operator": "EqualTo",
              "RightOperand": "0",
              "Type": "Expression"
            },
            "Type": "If"
          },
          "Type": "BooleanExpression",
          "inPage": false
        },
        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function()\n{\n\tfunction getRandomFromBucket(bucket) {\n\t\tvar randomIndex = Math.floor(Math.random()*bucket.length);\n\t\treturn bucket.splice(randomIndex, 1)[0];\n\t}\n\t\n\tvar lt_bin = [\"-$4\", \"$0\", \"$2\", \"$4\"]\n\tvar kw_bin = [\"$0\", \"$4\", \"$6\", \"$8\"]\n\t\n\n\t  for (var i = 0; i < 4; ++i) {\n\t\t  var lt = getRandomFromBucket(lt_bin);\n\t\t  Qualtrics.SurveyEngine.setEmbeddedData('hp_lt_' + String(i+1), lt);\n\t\t\t\t  }\n\n\tfor (var i = 0; i < 4; ++i) {\n\t\tvar kw = getRandomFromBucket(kw_bin);\n\t\tQualtrics.SurveyEngine.setEmbeddedData('hp_kw_' + String(i+1), kw);\n\t}\n\n\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t/*Place your JavaScript here to run when the page is fully displayed*/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t/*Place your JavaScript here to run when the page is unloaded*/\n\n});"
      }
    },
