        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function() {\n\n  // Read transfer (amount sent) from embedded data\n  // (Ensure \"transfer\" is stored earlier as a number, e.g., \"6\" not \"$6\")\n  var transferRaw = \"${e://Field/transfer}\";\n  var transfer = parseFloat(transferRaw);\n\n  // Fallback if transfer is missing / not numeric\n  if (isNaN(transfer)) { transfer = 0; }\n\n  // Compute amount received by Player 2 (tripled)\n  var transfer3x = 3 * transfer;\n\n  // Store for display/use in the HTML (shown as ${e://Field/transfer_3x})\n  Qualtrics.SurveyEngine.setEmbeddedData(\"transfer_3x\", transfer3x);\n\n  // Configure slider bounds dynamically\n  var slider = document.getElementById(\"beliefSlider\");\n  slider.max = transfer3x;\n  slider.value = 0;\n\n  // If you want integer dollars only, change step to 1\n  slider.step = 0.5;\n\n  /* Belief Slider */\n  slider.oninput = function() {\n    writeBeliefValue();\n    storeBeliefValue();\n    jQuery(\"#NextButton\").show();\n  };\n\n  function writeBeliefValue() {\n    slider.className = \"slider_click\";\n    var val = parseFloat(slider.value);\n    // Format nicely: no trailing .0 if integer\n    var shown = (Math.round(val) === val) ? val.toFixed(0) : val.toFixed(1);\n    document.getElementById(\"beliefOutput\").innerHTML = \"$\" + shown;\n  }\n\n  function storeBeliefValue() {\n    var val = slider.value;\n    Qualtrics.SurveyEngine.setEmbeddedData(\"beliefs\", val);\n  }\n\n});",
        "DisplayLogic": {
          "0": {
            "0": {
              "Description": "<span class=\"ConjDesc\">If</span> <span class=\"LeftOpDesc\">transfer</span> <span class=\"OpDesc\">Is Greater Than</span> <span class=\"RightOpDesc\"> 0 </span>",
              "LeftOperand": "transfer",
              "LogicType": "EmbeddedField",
              "Operator": "GreaterThan",
              "RightOperand": "0",
              "Type": "Expression"
