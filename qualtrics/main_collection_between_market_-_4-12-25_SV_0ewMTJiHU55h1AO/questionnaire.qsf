    {
      "SurveyID": "SV_0ewMTJiHU55h1AO",
      "Element": "SQ",
      "PrimaryAttribute": "QID109",
      "SecondaryAttribute": "The computer selected a starting price of $12 for the voucher.   You may change the price by any...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">The computer selected a <b>starting price of $12</b> for the voucher.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You may change the price by any amount between -$12 and $0. A negative change means that you decrease the price.</span></div>\n\n<div style=\"text-align: center;\"><span style=\"font-size:22px;\">&nbsp;</span></div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">We now present four hypothetical price changes. We ask you to describe a real-world situation you find each similar to. The situation can involve two people or groups. It can be an experience you or somebody you know lived, or it could be fictional.&nbsp;</span></div>\n\n<div style=\"text-align: left;\"><br>\n<span style=\"font-size:22px;\">Then, you may choose your price change.</span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "The computer selected a starting price of $12 for the voucher.   You may change the price by any...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionText_Unsafe": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$8</b>. The other participant was provisionally allocated <b>$4</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You have the option to make a transfer to the other participant. You can transfer any amount between $0 and $8.<br><br>We now present two allocations and we ask you to describe a real-world situation that you find similar to each.<br><br>Then, you may choose the amount of your transfer.<br></span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DataExportTag": "Q109",
        "QuestionID": "QID109"
      }
    },
