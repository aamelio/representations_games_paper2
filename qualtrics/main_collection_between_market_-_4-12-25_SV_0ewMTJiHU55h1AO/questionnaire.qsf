    {
      "SurveyID": "SV_0ewMTJiHU55h1AO",
      "Element": "SQ",
      "PrimaryAttribute": "QID8",
      "SecondaryAttribute": "Please decide how to split the money between you and your match. You: Click on the slider   Your...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "Please decide how to split the money between you and your match.<br><br>\n\n<div><br></div><table style=\"margin-left: auto; \n  margin-right: auto;\"><tbody><tr><td><table id=\"${e://Field/color_1}\"><tbody>\n     <tr>\n      <td><input value=\"${lm://Field/1}\" type=\"range\" step=\"1\" min=\"0\" max=\"10\" list=\"tickmarks\" id=\"topleftSlider\" class=\"slider\">\n      <div>\n      <center><b>You: <b><span id=\"output1\"> Click on the slider </span></b></b></center>\n      </div>\n      </td>\n     </tr>\n     <tr>\n      <td><br>\n      &nbsp;</td>\n     </tr>\n     <tr>\n     </tr>\n     <tr>\n      <td><input type=\"range\" step=\"1\" min=\"0\" max=\"10\" list=\"tickmarks\" id=\"bottomleftSlider\" class=\"slider\">\n      <div>\n      <center><b>Your match: <b><span id=\"output3\"> Click on the slider </span></b></b></center>\n      </div>\n      <b> </b></td>\n     </tr>\n     <tr>\n      <td><br>\n      &nbsp;</td>\n     </tr>\n     <tr>\n     </tr>\n    </tbody>\n   </table>\n </td><td>\n    </td></tr></tbody>\n   </table>\n\n<center>&nbsp;</center>",
        "DefaultChoices": false,
        "DataExportTag": "Q8",
        "QuestionID": "QID8",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Please decide how to split the money between you and your match. You: Click on the slider   Your...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 2,
        "NextAnswerId": 1,
        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function() {\n\t\n/* For each slider: i) Change shown value after each movement ii) Dynamically change complementary \niii) Store current value in a list (only for top sliders, corresponding to bag A)  */\nvar list_left =  [];\nvar round = \"${lm://CurrentLoopNumber}\";\nvar endowment = \"${lm://Field/1}\"\n\nQualtrics.SurveyEngine.setEmbeddedData('endowment_' + round, endowment)\nQualtrics.SurveyEngine.setEmbeddedData('allocation_' + round, endowment)\n\n\n/* Top Left Slider */\n\t\n document.getElementById(\"topleftSlider\").oninput = function() {\n\twriteValuetopleft();\n    getValuetopleft();\n\tjQuery(\"#NextButton\").show();\n };\n\t\nfunction writeValuetopleft() {\n   document.getElementById(\"topleftSlider\").className = \"slider_click\"\n   document.getElementById(\"bottomleftSlider\").className = \"slider_click\"\n   var val = document.getElementById(\"topleftSlider\").value //get the oninput value\n   document.getElementById('output1').innerHTML = val + \"$\" //display this value to the html page\n   document.getElementById(\"bottomleftSlider\").value = 10 - val //set complementary slider value\n   document.getElementById('output3').innerHTML = 10 - val + \"$\"\n}\n\nfunction getValuetopleft() {\n   var val = document.getElementById(\"topleftSlider\").value //get the oninput value\n   Qualtrics.SurveyEngine.setEmbeddedData('allocation_' + round, val)\n\n}\n\n\n/* Bottom Left Slider */\n\n document.getElementById(\"bottomleftSlider\").oninput = function() {\n\t  writeValuebottomleft();\n    getValuebottomleft();\n\tjQuery(\"#NextButton\").show();\n };\n\nfunction writeValuebottomleft() {\n   document.getElementById(\"topleftSlider\").className = \"slider_click\"\n   document.getElementById(\"bottomleftSlider\").className = \"slider_click\"\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   document.getElementById('output3').innerHTML = val + \"%\" //display this value to the html page\n   document.getElementById(\"topleftSlider\").value = 10 - val //set complementary slider value\n   document.getElementById('output1').innerHTML = 10 - val + \"%\"\n}\n\n\nfunction getValuebottomleft() {\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   Qualtrics.SurveyEngine.setEmbeddedData('allocation_' + round, 10-val)\n\t\n}\n\n\n\n\n\t\n});"
      }
    },
    {
      "SurveyID": "SV_0ewMTJiHU55h1AO",
      "Element": "SQ",
      "PrimaryAttribute": "QID80",
      "SecondaryAttribute": "You were provisionally allocated $8. The other participant was provisionally allocated $4.   You...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$8</b>. The other participant was provisionally allocated <b>$4</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You have the option to make a transfer to the other participant. You can transfer any amount between $0 and $8.<br><br>We now present three hypothetical final allocations and we ask you to describe a real-world situation that you find similar to each. The situation can involve two people or groups. It can be an experience you or somebody you know lived, or it could be fictional.<br><br>Then, you may choose the amount of your transfer.<br></span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "You were provisionally allocated $8. The other participant was provisionally allocated $4.   You...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionText_Unsafe": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$8</b>. The other participant was provisionally allocated <b>$4</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You have the option to make a transfer to the other participant. You can transfer any amount between $0 and $8. How much do you want to transfer?<br><br>Afterward, we present two allocations and we ask you to describe a real-world situation that you find similar to each.\r\n<br></span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DataExportTag": "Q80",
        "QuestionID": "QID80"
      }
    },
