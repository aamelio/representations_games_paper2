      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\">\n<div style=\"text-align: center;\"><span style=\"font-size:22px;\">The computer selected a <b>starting price of</b>&nbsp;<b>$12</b> for the voucher.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You may change the price by any amount between -$12 and $0. A negative change means that you decrease the price.</span></div>\n</div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
