      "SurveyID": "SV_0ewMTJiHU55h1AO",
      "Element": "SQ",
      "PrimaryAttribute": "QID60",
      "SecondaryAttribute": "The computer selected a starting price of $8 for the data.   We now present four hypothetical pri.",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">The computer selected a <b>starting price of</b>&nbsp;<b>$8</b> for the data.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">We now present four hypothetical price changes. We ask you to describe a real-world situation you find each similar to.&nbsp;The situation can involve two people or groups. It can be an experience you or somebody you know lived, or it could be fictional.</span></div>\n\n<div style=\"text-align: left;\">&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You may change the price by any amount between -$8 and +$4. A positive change means that you increase the price, while a negative change means that you decrease the price.<br>\n<br>\nThe hypothetical price changes are:</span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DefaultChoices": false,
        "DataExportTag": "Q60",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "The computer selected a starting price of $8 for the data.   We now present four hypothetical pri...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionID": "QID60"
      }
    },
    {
