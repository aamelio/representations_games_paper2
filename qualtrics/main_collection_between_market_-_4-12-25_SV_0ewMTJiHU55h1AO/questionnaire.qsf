        "QuestionText_Unsafe": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You have been assigned <b>$${lm://Field/1}</b>&nbsp;and your match has been assigned&nbsp;<b>$${lm://Field/2}</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">${lm://Field/3}</span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DataExportTag": "Q31",
