      "SurveyID": "SV_0ewMTJiHU55h1AO",
      "Element": "SQ",
      "PrimaryAttribute": "QID31",
      "SecondaryAttribute": "The computer selected a starting price of $8 for the data.   You may change the price by any amou.",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">The computer selected a <b>starting price of</b>&nbsp;<b>$8</b> for the data.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You may change the price by any amount between -$8 and +$4. A positive change means that you increase the price, while a negative change means that you decrease the price.</span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
