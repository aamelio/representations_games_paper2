    {
      "SurveyID": "SV_0ewMTJiHU55h1AO",
      "Element": "SQ",
      "PrimaryAttribute": "QID43",
      "SecondaryAttribute": "You were provisionally allocated $8. The other participant was provisionally allocated $4.   You...",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$8</b>. The other participant was provisionally allocated <b>$4</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You have the option to make a transfer to the other participant. You can transfer any amount between $0 and $8. How much do you want to transfer?<br></span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "You were provisionally allocated $8. The other participant was provisionally allocated $4.   You...",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionText_Unsafe": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You have been assigned <b>$8</b>&nbsp;and your match has been assigned&nbsp;<b>$4</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">You can decide whether and how to change this provisional allocation. You can choose any split of the $12, ranging from taking $4 from your match to giving them entirely to your match or anything in between.</span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DataExportTag": "Q43",
        "QuestionID": "QID43"
      }
    },
    {
      "SurveyID": "SV_0ewMTJiHU55h1AO",
      "Element": "SQ",
      "PrimaryAttribute": "QID44",
      "SecondaryAttribute": "Please choose your transfer to the other participant.     Your transfer: Click on the slider",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\">Please choose your transfer to the other participant.</div>\n&nbsp;\n\n<div>&nbsp;</div>\n\n<table style=\"margin-left: auto; \n  margin-right: auto;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<table id=\"${e://Field/color_1}\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td><input value=\"0\" type=\"range\" step=\"0.5\" min=\"0\" max=\"8\" list=\"tickmarks\" id=\"bottomleftSlider\" class=\"slider\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t<center><b>Your transfer: <b><span id=\"output3\"> Click on the slider </span></b></b></center>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<b> </b></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td><br></td></tr></tbody></table></td><td></td></tr></tbody></table>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Please choose your transfer to the other participant.     Your transfer: Click on the slider",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 2,
        "NextAnswerId": 1,
        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function() {\n\nvar round = \"${e://Field/round}\";\nvar endowment = 8\n\nQualtrics.SurveyEngine.setEmbeddedData('endowment_' + round, endowment)\nQualtrics.SurveyEngine.setEmbeddedData('treatment_' + round, 'lg')\n\n/* Bottom Left Slider */\n\n document.getElementById(\"bottomleftSlider\").oninput = function() {\n\t writeValuebottomleft();\n    getValuebottomleft();\n\tjQuery(\"#NextButton\").show();\n };\n\nfunction writeValuebottomleft() {\n   document.getElementById(\"bottomleftSlider\").className = \"slider_click\"\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   document.getElementById('output3').innerHTML =\"$\"+ val //display this value to the html page\n}\n\n\nfunction getValuebottomleft() {\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   Qualtrics.SurveyEngine.setEmbeddedData('allocation_' + round, 8-val)\n   Qualtrics.SurveyEngine.setEmbeddedData('transfer_' + round, val)\t\n}\n\n\t\n});",
        "QuestionText_Unsafe": "Please decide how to split the $12 between you and your match.<br><br>\n\n<div><br></div><table style=\"margin-left: auto; \n  margin-right: auto;\"><tbody><tr><td><table id=\"${e://Field/color_1}\"><tbody>\n     <tr>\n      <td><input value=\"8\" type=\"range\" step=\"1\" min=\"0\" max=\"12\" list=\"tickmarks\" id=\"topleftSlider\" class=\"slider\">\n      <div>\n      <center><b>You: <b><span id=\"output1\"> Click on the slider </span></b></b></center>\n      </div>\n      </td>\n     </tr>\n     <tr>\n      <td><br>\n      &nbsp;</td>\n     </tr>\n     <tr>\n     </tr>\n     <tr>\n      <td><input value=\"4\" type=\"range\" step=\"1\" min=\"0\" max=\"12\" list=\"tickmarks\" id=\"bottomleftSlider\" class=\"slider\">\n      <div>\n      <center><b>Your match: <b><span id=\"output3\"> Click on the slider </span></b></b></center>\n      </div>\n      <b> </b></td>\n     </tr>\n     <tr>\n      <td><br>\n      &nbsp;</td>\n     </tr>\n     <tr>\n     </tr>\n    </tbody>\n   </table>\n </td><td>\n    </td></tr></tbody>\n   </table>\n\n<center>&nbsp;</center>",
        "DataExportTag": "Q44",
        "QuestionID": "QID44"
      }
