    {
      "SurveyID": "SV_0ewMTJiHU55h1AO",
      "Element": "SQ",
      "PrimaryAttribute": "QID17",
      "SecondaryAttribute": "Please choose your transfer to the other participant.   Your transfer: Click on the slider",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div style=\"text-align: center;\">Please choose your transfer to the other participant.</div>\n\n<div>&nbsp;</div>\n\n<table style=\"margin-left: auto; \n  margin-right: auto;\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<table id=\"${e://Field/color_1}\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td><input value=\"0\" type=\"range\" step=\"0.5\" min=\"0\" max=\"12\" list=\"tickmarks\" id=\"bottomleftSlider\" class=\"slider\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t<center><b>Your transfer: <b><span id=\"output3\"> Click on the slider </span></b></b></center>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<b> </b></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td><br></td></tr></tbody></table></td><td></td></tr></tbody></table>",
        "DefaultChoices": false,
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Please choose your transfer to the other participant.   Your transfer: Click on the slider",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 2,
        "NextAnswerId": 1,
        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function() {\n\nvar round = \"${e://Field/round}\";\nvar endowment = 12\n\nQualtrics.SurveyEngine.setEmbeddedData('endowment_' + round, endowment)\nQualtrics.SurveyEngine.setEmbeddedData('treatment_' + round, 'kw')\n\n/* Bottom Left Slider */\n\n document.getElementById(\"bottomleftSlider\").oninput = function() {\n\t writeValuebottomleft();\n    getValuebottomleft();\n\tjQuery(\"#NextButton\").show();\n };\n\nfunction writeValuebottomleft() {\n   document.getElementById(\"bottomleftSlider\").className = \"slider_click\"\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   document.getElementById('output3').innerHTML =\"$\"+ val //display this value to the html page\n}\n\n\nfunction getValuebottomleft() {\n   var val = document.getElementById(\"bottomleftSlider\").value //get the oninput value\n   Qualtrics.SurveyEngine.setEmbeddedData('allocation_' + round, 12-val)\n   Qualtrics.SurveyEngine.setEmbeddedData('transfer_' + round, val)\t\n}\n\n\t\n});",
        "QuestionText_Unsafe": "Please decide how to split the money between you and your match.<br><br>\n\n<div><br></div><table style=\"margin-left: auto; \n  margin-right: auto;\"><tbody><tr><td><table id=\"${e://Field/color_1}\"><tbody>\n     <tr>\n      <td><input value=\"${lm://Field/1}\" type=\"range\" step=\"1\" min=\"0\" max=\"10\" list=\"tickmarks\" id=\"topleftSlider\" class=\"slider\">\n      <div>\n      <center><b>You: <b><span id=\"output1\"> ${lm://Field/1}$</span></b></b></center>\n      </div>\n      </td>\n     </tr>\n     <tr>\n      <td><br>\n      &nbsp;</td>\n     </tr>\n     <tr>\n     </tr>\n     <tr>\n      <td><input value=\"${lm://Field/2}\" type=\"range\" step=\"1\" min=\"0\" max=\"10\" list=\"tickmarks\" id=\"bottomleftSlider\" class=\"slider\">\n      <div>\n      <center><b>Your match: <b><span id=\"output3\"> ${lm://Field/2}$</span></b></b></center>\n      </div>\n      <b> </b></td>\n     </tr>\n     <tr>\n      <td><br>\n      &nbsp;</td>\n     </tr>\n     <tr>\n     </tr>\n    </tbody>\n   </table>\n </td><td>\n    </td></tr></tbody>\n   </table>\n\n<center>&nbsp;</center>",
        "DataExportTag": "Q17",
        "QuestionID": "QID17"
      }
    },
