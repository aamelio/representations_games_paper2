          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionText_Unsafe": "<div style=\"text-align: center;\"><span style=\"font-size:22px;\">You were provisionally allocated <b>$8</b>. The other participant was provisionally allocated <b>$4</b>.</span><br>\n&nbsp;</div>\n\n<div style=\"text-align: left;\"><span style=\"font-size:22px;\">We now present four final allocations in this same task. We then ask you to describe a real world situation you find each similar to. Remember that the task is:<br><br>You have the option to make a transfer to the other participant. You can transfer any amount between $0 and $8.<br></span></div>\n\n<div style=\"text-align: center;\">&nbsp;</div>",
        "DataExportTag": "Q98",
        "QuestionID": "QID98"
      }
